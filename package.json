{
  "name": "agentide",
  "version": "0.0.1",
  "description": "Agent-first review IDE (pronounced like \"agentic\")",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:runner": "esbuild src/runner/index.ts --bundle --platform=node --format=esm --target=node22 --external:@anthropic-ai/claude-agent-sdk --outfile=sandbox/dist/runner.mjs",
    "build:sandbox": "npm run build:runner && docker build -t agentide-sandbox --build-arg SDK_VERSION=$(node -p \"require('./package.json').devDependencies['@anthropic-ai/claude-agent-sdk']\") sandbox"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
