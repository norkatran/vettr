{
  "name": "vettr-runner",
  "version": "0.0.1",
  "description": "Sandbox runner: wraps the Claude Agent SDK inside the vettr Docker container",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@anthropic-ai/claude-agent-sdk --external:zod --outfile=dist/runner.mjs",
    "build:sandbox": "npm run build && docker build -t vettr-sandbox --build-arg SDK_VERSION=$(node -p \"require('./package.json').devDependencies['@anthropic-ai/claude-agent-sdk']\") -f ../sandbox/Dockerfile .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
